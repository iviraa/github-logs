# Local development only. The deployed Lambdas read these from SAM env vars + Secrets Manager.
GITHUB_USERNAME=example-user
GITHUB_TOKEN=ghp_replace_me
AWS_REGION=us-east-1
ACTIVITY_TABLE=DeveloperActivity
REPORTS_TABLE=GeneratedReports
RAW_ARCHIVE_BUCKET=github-logs-raw-archive-REPLACE
REPORTS_BUCKET=github-logs-reports-REPLACE
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:github-logs-weekly
BEDROCK_MODEL_ID=replace-with-your-claude-bedrock-model-id
GITHUB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:github-logs/pat-XXXX
